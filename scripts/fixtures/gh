#!/usr/bin/env node
import { appendFileSync, readFileSync } from "node:fs";
import { respond } from "../target-fixture.mjs";

const trace = process.env.PR_REVIEW_SMOKE_TRACE;
if (!trace) throw new Error("This gh test double requires PR_REVIEW_SMOKE_TRACE.");
const args = process.argv.slice(2);
const cwd = process.cwd();
const history = readFileSync(trace, "utf8").split("\n").filter(Boolean).map(JSON.parse);
appendFileSync(trace, `${JSON.stringify({ args, cwd, repoOverride: process.env.GH_REPO ?? null })}\n`);
try {
  process.stdout.write(respond(args, cwd, history));
} catch (error) {
  console.error(error.message);
  process.exitCode = 1;
}
